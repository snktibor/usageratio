# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# The Windows client scripts keep LF in the repo; the ZIP builder converts
# them per platform at package time (lib/setup-package.ts).
[*.{ps1,cmd}]
end_of_line = lf
