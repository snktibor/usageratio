{
  "name": "usageratio",
  "version": "0.6.0",
  "private": true,
  "description": "A lightweight, self-hosted usage tracker for weekly or monthly token budgets across multiple AI providers or accounts.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Tibor Sinka",
    "url": "https://github.com/snktibor"
  },
  "homepage": "https://github.com/snktibor/usageratio#readme",
  "bugs": {
    "url": "https://github.com/snktibor/usageratio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snktibor/usageratio.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ccusage",
    "token-usage",
    "ai-agents",
    "usage-dashboard",
    "budget",
    "nextjs",
    "upstash-redis",
    "vercel",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "prepare": "node scripts/generate-locales.mjs",
    "predev": "node scripts/generate-locales.mjs",
    "prebuild": "node scripts/generate-locales.mjs",
    "pretypecheck": "node scripts/generate-locales.mjs",
    "pretest": "node scripts/generate-locales.mjs",
    "precoverage": "node scripts/generate-locales.mjs",
    "dev": "next dev",
    "dev:demo": "cross-env DEMO_MODE=1 next dev",
    "build": "next build",
    "start": "next start",
    "start:demo": "cross-env DEMO_MODE=1 next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome ci . && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "brand": "node scripts/brand/render.mjs",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "migrate:legacy": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-legacy.ts",
    "redis:up": "docker compose -f docker-compose.dev.yml up -d",
    "redis:down": "docker compose -f docker-compose.dev.yml down",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "screenshots": "cross-env SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --project=demo --project=real",
    "docker:build": "docker build -t usageratio ."
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "next": "16.4.0",
    "next-intl": "^4.14.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
