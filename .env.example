# ── Required ────────────────────────────────────────────────────────────────

# Secret the client scripts send as "Authorization: Bearer …" (min. 16 chars).
# Generate one with:  openssl rand -hex 32
USAGE_API_TOKEN=

# The dashboard PIN or passphrase: 5–64 characters. Digits only gives a numeric
# keypad; on a public URL prefer a passphrase of 12+ characters.
# Changing it logs every browser out.
DASHBOARD_PIN=

# Redis (REST). On Vercel these two are injected automatically once the
# Upstash Redis store is connected to the project — do not set them by hand.
# The values below match docker-compose.dev.yml for local development.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as well.)
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local_dev_token

# ── Optional: the setup page's "copy the API token" button ──────────────────

# AES-256-GCM key for the copy of USAGE_API_TOKEN saved on the settings panel.
# Exactly 32 bytes, as 64 hex digits or base64:  openssl rand -base64 32
# Without it the copy cannot be stored.
# TOKEN_ENCRYPTION_KEY=
# Key rotation: put the old key here and the new one above, redeploy, open the
# settings panel once (the copy is re-sealed with the new key), then remove it.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── Optional: login ─────────────────────────────────────────────────────────

# SESSION_IDLE_DAYS=7        # a session nobody used for this long logs out
# SESSION_MAX_DAYS=30        # the hard ceiling from login, however active
# DASHBOARD_PIN_AUTOSUBMIT=1 # submit a numeric PIN on its last digit (reveals the PIN's length)

# ── Optional overrides of lib/config.ts ─────────────────────────────────────

# RESET_TIMEZONE=Europe/Budapest   # only the initial value; the settings panel decides afterwards
# TOKEN_MODE=snapshot        # snapshot (ccusage clients) | delta | counter

# Seeds only: this is the initial limit of every newly discovered provider.
# Provider-specific budgets are edited on the dashboard and stored in Redis.
# WEEKLY_LIMIT=500000
# RESET_WEEKDAY=1            # 0 = Sunday … 6 = Saturday
# RESET_TIME=00:00           # HH:MM, 24h

# ── Security headers ────────────────────────────────────────────────────────

# SECURITY_CSP=enforce       # enforce | report (log violations only) | off; development is always report-only
# SECURITY_HSTS=0            # HSTS is sent behind HTTPS by default; 0 turns it off
# SECURITY_HSTS_PRELOAD=1    # add "preload" (only once the domain should be on the preload list)

# ── Operations ──────────────────────────────────────────────────────────────

# Vercel Cron calls /api/cron/housekeeping daily with this as a bearer token
# (min. 16 chars). Without it the housekeeping endpoint refuses to run.
# CRON_SECRET=
# ERROR_WEBHOOK_URL=         # server errors are POSTed here as JSON (message, digest, path, request id)
# LOG_LEVEL=info             # debug | info | warn | error
# LOG_FORMAT=json            # json (default in production) | pretty
# TRUST_PROXY=1              # trust x-forwarded-for for rate limits (always on Vercel);
#                            # set to 0 on a self-hosted server that is not behind a proxy
# COOKIE_SECURE=true         # force the Secure flag on cookies (auto-detected on Vercel / https)
# AUDIT_SALT=                # salt of the hashed IPs in the token audit trail (default: derived from TOKEN_ENCRYPTION_KEY)
# AUDIT_RAW_IP=1             # keep the full IP address in the audit trail instead of a /24 prefix and a hash
# AUDIT_RETENTION_DAYS=365   # audit entries older than this are removed by housekeeping

# ── Local development without Docker ────────────────────────────────────────

# USAGE_STORE=memory         # an in-memory Redis (lib/redis-memory.ts) instead of KV_REST_API_*;
#                            # everything is lost when the server stops
# DEMO_MODE=1                # `npm run dev:demo`: the in-memory store seeded with synthetic data,
#                            # no PIN, every write answers 403 — never set this on a real deployment
# DEMO_FIXED_TIME=2026-09-23T12:00:00Z   # freezes "now" in demo mode (screenshots, e2e)
