# ── Required ────────────────────────────────────────────────────────────────

# Secret the client scripts send as "Authorization: Bearer …" (min. 16 chars).
# Generate one with:  openssl rand -hex 32
USAGE_API_TOKEN=

# The dashboard PIN (5 digits). Changing it logs every browser out.
DASHBOARD_PIN=

# Redis (REST). On Vercel these two are injected automatically once the
# Upstash Redis store is connected to the project — do not set them by hand.
# The values below match docker-compose.dev.yml for local development.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as well.)
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local_dev_token

# ── Optional: the setup page's "copy the API token" button ──────────────────

# AES-256-GCM key for the copy of USAGE_API_TOKEN saved on the settings panel.
# Exactly 32 bytes, as 64 hex digits or base64:  openssl rand -base64 32
# Without it the copy cannot be stored. Changing it makes the stored copy
# unreadable: save the token again on the panel.
# TOKEN_ENCRYPTION_KEY=

# ── Optional overrides of lib/config.ts ─────────────────────────────────────

# RESET_TIMEZONE=Europe/Budapest   # only the initial value; the settings panel decides afterwards
# TOKEN_MODE=snapshot        # snapshot (ccusage clients) | delta | counter

# Seeds only: this is the initial limit of every newly discovered provider.
# Provider-specific budgets are edited on the dashboard and stored in Redis.
# WEEKLY_LIMIT=500000
# RESET_WEEKDAY=1            # 0 = Sunday … 6 = Saturday
# RESET_TIME=00:00           # HH:MM, 24h

# ── Local development without Docker ────────────────────────────────────────

# USAGE_STORE=memory         # an in-memory Redis (lib/redis-memory.ts) instead of KV_REST_API_*;
#                            # everything is lost when the server stops
# DEMO_MODE=1                # `npm run dev:demo`: the in-memory store seeded with synthetic data,
#                            # no PIN, every write answers 403 — never set this on a real deployment
# DEMO_FIXED_TIME=2026-09-23T12:00:00Z   # freezes "now" in demo mode (screenshots, e2e)

# ── Operations ──────────────────────────────────────────────────────────────

# LOG_LEVEL=info             # debug | info | warn | error
# LOG_FORMAT=json            # json (default in production) | pretty
# TRUST_PROXY=1              # trust x-forwarded-for for the login rate limit (always on Vercel);
#                            # set to 0 on a self-hosted server that is not behind a proxy
# COOKIE_SECURE=true         # force the Secure flag on the session cookie (auto-detected on Vercel / https)
